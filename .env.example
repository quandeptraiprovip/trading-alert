# Copy thành .env.local rồi điền giá trị thật (file .env.local KHÔNG commit).

# ── Telegram bot ────────────────────────────────────────────────────────────
# Bật/tắt Telegram (mặc định: false — bot chỉ log ra console)
TELEGRAM_ENABLED=false
# Lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Chat ID nhận alert — dùng @userinfobot hoặc https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ── Giao dịch thật trên Binance USDⓈ-M Futures (tuỳ chọn) ────────────────────
# Bật đặt lệnh THẬT. Mặc định false → bot chỉ cảnh báo (alert-only) như cũ.
TRADING_ENABLED=false
SMC_ENABLED=false       # false = tắt entry SMC; vị thế SMC cũ (nếu có) chỉ được drain tới khi thoát
# true = TESTNET (testnet.binancefuture.com) — KHUYẾN NGHỊ chạy thử trước.
# false = MAINNET (tiền thật, fapi.binance.com). ⚠️ Chỉ đổi khi đã verify trên testnet.
BINANCE_TESTNET=false
# API key/secret cho Futures. Testnet: tạo ở https://testnet.binancefuture.com (nút API Key).
# Mainnet: Binance → API Management, BẬT quyền "Enable Futures", nên giới hạn IP của VM.
# (tuỳ chọn) Ghi đè base URL nếu testnet đổi domain (vd https://demo-fapi.binance.com).
# BINANCE_BASE_URL=

# ── Quản trị rủi ro ──────────────────────────────────────────────────────────
RISK_PCT=5                  # % equity rủi ro MỖI lệnh (trước sizeMult của bot 0.6/1.0/1.5)
MAX_PORTFOLIO_RISK_PCT=20   # trần TỔNG risk các vị thế mở đồng thời — CHUNG cho SMC + Turtle + Fast
LEVERAGE=10                 # đòn bẩy đặt cho mỗi symbol (risk do SL quyết; đòn bẩy chỉ ảnh hưởng vùng thanh lý)
MARGIN_TYPE=ISOLATED        # ISOLATED hoặc CROSSED

# ── TURTLE HYBRID (long close 15d/mid-exit; short close 30d/Chandelier) ──
# Alert luôn bật khi TURTLE_ENABLED=true; đặt lệnh THẬT cần thêm TRADING_ENABLED=true.
TURTLE_ENABLED=true
TURTLE_TRADING_ENABLED=true # false = turtle chỉ alert
TURTLE_RISK_PCT=0.5         # % equity / UNIT (tối đa 4 unit = tối đa danh nghĩa 2%).
                            # Lệnh nhỏ hơn sàn minNotional (BTC=100 USDT) được tự NÂNG qty lên sàn;
                            # bù lại tổng risk mỗi vị thế bị khoá ở 4×TURTLE_RISK_PCT (equity nhỏ →
                            # BTC vào 1-2 unit to thay vì 4 unit nhỏ, tổng risk không đổi).
# TURTLE_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt,dogeusdt,adausdt,avaxusdt,dotusdt

# ── Sleeve TREND NHANH → MEXC USDT-M Futures ─────────────────────────────────
# Fast dùng Binance Futures 4h làm dữ liệu tín hiệu, nhưng đặt/quản lý lệnh trên tài khoản MEXC
# riêng. Vì khác venue nên Fast và Turtle được phép giữ cùng coin.
FAST_TREND_ENABLED=true       # false = tắt hẳn sleeve nhanh
FAST_TREND_TRADING_ENABLED=false # shadow mặc định; chỉ bật sau forward-test, vẫn cần MEXC_TRADING_ENABLED=true
FAST_TREND_RISK_PCT=0.5       # % equity / UNIT (tối đa 3 unit = tối đa 1,5%) — nhỏ hơn turtle vì
                              # chiến lược mới hơn/lookback ngắn hơn, chưa có track record dài.
FAST_TREND_ENTRY_DAYS=10      # LONG high-breakout, thoát mid-close 20d; SHORT close-low 30d + xác nhận 1 nến 4h
# FAST_TREND_SYMBOLS=...      # mặc định = TURTLE_SYMBOLS
# FAST_TREND_DATA_DIR=...      # Docker Compose tự đặt vào directory bind-mount để atomic rename

# Client MEXC chỉ được tạo khi MEXC_ENABLED=true và có đủ key/secret.
# API key cần KYC + quyền "View Account Details", "View Order Details", "Order Placing".
# KHÔNG cấp quyền rút tiền; bật IP whitelist. Tài khoản Futures phải ở One-way mode.
MEXC_ENABLED=false
MEXC_TRADING_ENABLED=false    # fail-closed; chỉ đổi true sau khi /health và preflight pass
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://api.mexc.com
MEXC_RECV_WINDOW_MS=10000
MEXC_LEVERAGE=10
MEXC_MARGIN_TYPE=ISOLATED
MEXC_MAX_PORTFOLIO_RISK_PCT=10
MEXC_MAX_BASIS_PCT=0.3       # % chênh giá Binance signal ↔ MEXC; vượt thì bỏ entry/add

# ── Chart vàng XAUUSD từ OANDA v20 (read-only) ──────────────────────────────
# Chỉ dùng endpoint nến XAU_USD; không gửi lệnh OANDA.
OANDA_ENV=practice            # practice (mặc định) hoặc live
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
# OANDA_API_URL=              # tuỳ chọn; bỏ trống để dùng URL theo OANDA_ENV

# ── Kline cache (tuỳ chọn) ──────────────────────────────────────────────────
# KLINE_CACHE=0              # đặt = 0 để tắt cache đĩa (mặc định: bật)
# KLINE_FETCH_CONCURRENCY=4  # số request song song khi fetch nến (mặc định: 4)
